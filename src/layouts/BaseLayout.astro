---
// SPDX-License-Identifier: AGPL-3.0-or-later
import "@/styles/app.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
// The Latin subset is the only font every page needs immediately. Importing it
// as a URL yields the same hashed asset the stylesheet references, so
// preloading it starts the download with the CSS instead of after it — the
// font is otherwise discovered only once the stylesheet has parsed.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Set on the docs pages so the header can render the mobile nav. */
  currentSlug?: string;
  /**
   * Docs pages opt out: they end with the pager and the edit link, and their
   * sidebar scrolls independently, so a site footer just interrupts reading.
   */
  showFooter?: boolean;
}

const { title, description, currentSlug, showFooter = true } = Astro.props;
const siteTitle = title === "Omicron" ? "Omicron Documentation" : `${title} — Omicron Docs`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {/* Same set, and same order, as the app's app.html: browsers that only
        understand .ico take the first, everything modern takes the SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    {/* Resolve the theme before first paint so the page never flashes light. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("omicron-docs-theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* storage unavailable — fall back to the light default */
        }
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-input focus:border focus:border-border-input focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:text-foreground"
    >
      Skip to content
    </a>
    <Header {currentSlug} />
    <slot />
    {showFooter && <Footer />}
  </body>
</html>
