---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Logo from "@/components/Logo.astro";
import { hrefFor } from "@/lib/nav";

const year = new Date().getFullYear();

const groups = [
  {
    label: "Project",
    links: [
      { label: "Source", href: "https://github.com/the-jk-labs/omicron", external: true },
      { label: "Issues", href: "https://github.com/the-jk-labs/omicron/issues", external: true },
      { label: "Releases", href: "https://github.com/the-jk-labs/omicron/releases", external: true },
    ],
  },
  {
    label: "Documentation",
    links: [
      { label: "Quick start", href: hrefFor("quick-start"), external: false },
      { label: "Self-hosting", href: hrefFor("self-hosting/requirements"), external: false },
      { label: "Federation", href: hrefFor("federation/overview"), external: false },
    ],
  },
  {
    label: "Reference",
    links: [
      { label: "Environment variables", href: hrefFor("reference/environment"), external: false },
      { label: "HTTP API", href: hrefFor("reference/http-api"), external: false },
      { label: "Edit the docs", href: "https://github.com/the-jk-labs/omicron-docs", external: true },
    ],
  },
];

const linkClass =
  "text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:text-foreground";
---

<footer class="mt-auto border-t border-border bg-background-alt">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6">
    {/* Five columns on a 90rem shell: brand takes two, each link group one.
        Equal quarters left every column far wider than its content, so the
        text landed at arbitrary positions with dead space at the right. */}
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 pb-8 pt-12 md:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 max-w-xs md:col-span-3 lg:col-span-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-[15px] font-semibold tracking-tight text-foreground"
        >
          <Logo class="h-6 w-auto" size={24} />
          Omicron <span class="text-muted-foreground">docs</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Minimal, self-hostable, federated blogging over ActivityPub.
        </p>
      </div>

      {
        groups.map((group) => (
          <nav aria-label={group.label}>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground">
              {group.label}
            </p>
            <ul class="mt-4 flex flex-col gap-3">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class={linkClass}
                    {...link.external ? { target: "_blank", rel: "noreferrer noopener" } : {}}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {/* Licensing sits on its own line: two licences do not fit in a sentence
        without wrapping into an unreadable run-on. Separated by spacing, not a
        second rule — the footer's own top border is the only divider here. */}
    <div
      class="grid gap-x-8 gap-y-2 pb-10 text-xs text-muted-foreground sm:grid-cols-2 lg:grid-cols-5"
    >
      <p class="sm:col-span-1 lg:col-span-2">&copy; {year} The JK Labs</p>
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 sm:col-span-1 lg:col-span-3">
        <span>
          Code
          <a
            href="/docs/reference/license/"
            class="text-foreground-alt underline decoration-dark-40 underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
            >AGPL-3.0-or-later</a
          >
        </span>
        <span aria-hidden="true" class="text-dark-40">&middot;</span>
        <span>
          Text
          <a
            href="https://creativecommons.org/licenses/by-sa/4.0/"
            target="_blank"
            rel="license noreferrer noopener"
            class="text-foreground-alt underline decoration-dark-40 underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
            >CC BY-SA 4.0</a
          >
        </span>
      </p>
    </div>
  </div>
</footer>
