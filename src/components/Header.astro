---
// SPDX-License-Identifier: AGPL-3.0-or-later
import { getCollection } from "astro:content";
import SearchDialog from "@/components/SearchDialog.svelte";
import ThemeToggle from "@/components/ThemeToggle.svelte";
import MobileNav from "@/components/MobileNav.svelte";
import Logo from "@/components/Logo.astro";
import { nav, hrefFor, flatNav } from "@/lib/nav";

interface Props {
  currentSlug?: string;
}
const { currentSlug } = Astro.props;

// The offline index behind the search dialog: every page's title, blurb, and
// section. Pagefind replaces it with full-text results in a built site.
const entries = await getCollection("docs");
const sectionOf = (slug: string) =>
  nav.find((s) => s.items.some((i) => i.slug === slug))?.label ?? "Docs";
const pages = flatNav
  .map((item) => {
    const entry = entries.find((e) => e.id === item.slug);
    return entry
      ? {
          title: entry.data.title,
          description: entry.data.description,
          href: hrefFor(item.slug),
          section: sectionOf(item.slug),
        }
      : null;
  })
  .filter((p) => p !== null);
---

<header
  class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70"
  style="height: var(--header-height)"
>
  {/* Same max width and padding as the docs shell, so the wordmark lines up
      with the sidebar and the search cluster with the table of contents. */}
  <div class="mx-auto flex h-full max-w-[90rem] items-center gap-3 px-4 sm:px-6">
    {currentSlug && <MobileNav client:load sections={nav} currentSlug={currentSlug} />}

    <a
      href="/"
      class="flex items-center gap-2 rounded-button text-[15px] font-semibold tracking-tight text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <Logo class="h-7 w-auto shrink-0" />
      Omicron
      <span class="hidden text-muted-foreground sm:inline">docs</span>
    </a>

    <div class="ml-auto flex items-center gap-2">
      <SearchDialog client:load pages={pages} />
      <a
        href="https://github.com/the-jk-labs/omicron"
        target="_blank"
        rel="noreferrer noopener"
        aria-label="Omicron on GitHub"
        class="inline-flex size-9 items-center justify-center rounded-input border border-border-input bg-background-alt text-foreground shadow-btn transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-[18px]" aria-hidden="true">
          <path
            d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 2.5-.34c.85 0 1.71.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
