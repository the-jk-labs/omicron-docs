---
// The Omicron mark. `public/logo.svg` is byte-identical to the app's
// `src/lib/assets/omicron.svg`, rendered as an <img> exactly as the app's Nav
// does — so the docs header and the product header show the same artwork.
interface Props {
  class?: string;
  /** Intrinsic size hint; the class controls the rendered size. */
  size?: number;
}
const { class: className = "h-7 w-auto", size = 28 } = Astro.props;
---

<img src="/logo.svg" alt="" width={size} height={size} class={className} />
