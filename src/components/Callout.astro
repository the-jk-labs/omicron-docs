---
// Admonition block for MDX pages: <Callout type="warning" title="…">body</Callout>
interface Props {
  type?: "note" | "tip" | "warning" | "danger";
  title?: string;
}

const { type = "note", title } = Astro.props;

const styles = {
  note: { box: "border-border bg-muted/50", label: "text-foreground", icon: "text-dark-40" },
  tip: { box: "border-border bg-accent/30", label: "text-foreground", icon: "text-dark-40" },
  warning: {
    box: "border-tertiary/40 bg-tertiary/10",
    label: "text-foreground",
    icon: "text-tertiary",
  },
  danger: {
    box: "border-destructive/40 bg-destructive/10",
    label: "text-foreground",
    icon: "text-destructive",
  },
} as const;

const defaultTitles = {
  note: "Note",
  tip: "Tip",
  warning: "Careful",
  danger: "Warning",
} as const;

const style = styles[type];
const heading = title ?? defaultTitles[type];
---

<aside class:list={["my-6 rounded-card border px-4 py-3.5", style.box]}>
  <p class:list={["flex items-center gap-2 text-sm font-semibold", style.label]}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={["size-4 shrink-0", style.icon]}
      aria-hidden="true"
    >
      {
        type === "danger" || type === "warning" ? (
          <>
            <path d="M12 9v4M12 17h.01" />
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
          </>
        ) : (
          <>
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4M12 8h.01" />
          </>
        )
      }
    </svg>
    {heading}
  </p>
  <div class="prose-docs mt-2 [&>*:first-child]:mt-0 [&_p]:text-[0.9rem]">
    <slot />
  </div>
</aside>
